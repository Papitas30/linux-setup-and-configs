layout {

    focus-ring {
        active-color   "#61afef"
        inactive-color "#000000"
        urgent-color   "#e06c75"
    }

    border {
        active-color   "#61afef"
        inactive-color "#000000"
        urgent-color   "#e06c75"
    }


    tab-indicator {
        active-color   "#61afef"
        inactive-color "#324b63"
        urgent-color   "#e06c75"
    }

    insert-hint {
        color "#61afef80"
    }
}

recent-windows {
    highlight {
        active-color "#61afef"
        urgent-color "#e06c75"
    }
}
