abbr -g "rdeps"="\$(pactree -r -l %)"
abbr "execs"="exec zsh"
abbr "listsize"="pacman -Qi | awk '/^Name/{name=\$3} /^Installed Size/{print \$4\$5, name}' | LC_ALL=C.UTF-8 sort -h"
abbr "mountwin"="sudo mount -t ntfs-3g /dev/nvme0n1p4 /mnt/win"
abbr "nano"="micro"
abbr "spr"="sudo pacman -Rns"
abbr "sps"="sudo pacman -S"
abbr "spu"="sudo pacman -Syu"
abbr "spq"="sudo pacman -Qi"
abbr "unmountwin"="sudo umount /mnt/win"
